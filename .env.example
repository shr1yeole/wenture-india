# ============================================================
# Wenturex India International — Environment Configuration Template
# ============================================================

# Firebase Client Configuration (Frontend)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=wenture-india.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=wenture-india
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=wenture-india.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Site URL Configuration
NEXT_PUBLIC_SITE_URL=https://wentureindia.com

# Admin Email Whitelist (Comma-separated)
NEXT_PUBLIC_ADMIN_EMAILS=wentureindia@gmail.com,info@wentureindia.com

# Optional Email / Contact Routing
# CONTACT_EMAIL_RECIPIENT=info@wentureindia.com
